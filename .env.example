# Default provider is gemini (agent.provider in config.yaml).
GEMINI_API_KEY=

# Alternative provider: set agent.provider=anthropic (or SHEETAGENT_PROVIDER=anthropic)
# and SHEETAGENT_MODEL=claude-sonnet-5.
ANTHROPIC_API_KEY=

# Optional overrides
SHEETAGENT_PROVIDER=gemini
SHEETAGENT_MODEL=gemini-3.6-flash
SHEETAGENT_EXCEL_ENGINE=auto
SHEETAGENT_SPREADSHEET_ID=
GOOGLE_CREDENTIALS_FILE=credentials.json
SHEETAGENT_LOG_LEVEL=INFO
