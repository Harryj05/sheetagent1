ANTHROPIC_API_KEY=sk-ant-...
# Optional overrides
SHEETAGENT_MODEL=claude-sonnet-5
SHEETAGENT_EXCEL_ENGINE=auto
SHEETAGENT_SPREADSHEET_ID=
GOOGLE_CREDENTIALS_FILE=credentials.json
SHEETAGENT_LOG_LEVEL=INFO

